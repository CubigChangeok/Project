# 이 파일을 복사해서 이름을 .env 로 바꾸고, = 뒤에 키를 넣으세요. (.env는 GitHub에 올라가지 않습니다)

# 받아쓰기(소리 → 글자) + 화자 나누기: https://console.deepgram.com → API Keys
DEEPGRAM_API_KEY=

# 감정·문맥 교정·추천 답장·요약 AI: 둘 중 하나만 있어도 됩니다
# Gemini (무료로 시작 가능): https://aistudio.google.com → Get API key
GEMINI_API_KEY=
# Claude: https://platform.claude.com/settings/keys (API 크레딧 필요)
ANTHROPIC_API_KEY=

# 둘 다 있을 때 직접 고르려면: gemini 또는 claude (비워 두면 Claude 키가 있으면 Claude, 없으면 Gemini)
AI_PROVIDER=
